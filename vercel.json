{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/pocketfi-checkout", "destination": "/api/pocketfi" },
    { "source": "/api/pocketfi-webhook", "destination": "/api/pocketfi" }
  ],
  "crons": [
    {
      "path": "/api/products",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/grizzly-sync",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/grizzly-sync.js": {
      "maxDuration": 300
    },
    "api/logsdomain-numbers.js": {
      "maxDuration": 60
    }
  }
}
