{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/vendor",
      "destination": "/vendor.html"
    },
    {
      "source": "/vendor/",
      "destination": "/vendor.html"
    },
    {
      "source": "/become-a-vendor",
      "destination": "/vendor.html"
    },
    {
      "source": "/sub-admin",
      "destination": "/sub-admin.html"
    },
    {
      "source": "/sub-admin/",
      "destination": "/sub-admin.html"
    },
    {
      "source": "/api/pocketfi-checkout",
      "destination": "/api/pocketfi"
    },
    {
      "source": "/api/pocketfi-webhook",
      "destination": "/api/pocketfi"
    },
    {
      "source": "/api/products",
      "destination": "/api/order?action=sync"
    },
    {
      "source": "/api/products/",
      "destination": "/api/order?action=sync"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/landing.html",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/landing.html",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/landing.html",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/dashboard",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/grizzly-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/order-logsdomain?action=sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/classy",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/order?action=sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/owlet?action=sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/sujan?action=sync",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/sms-bus?action=sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/grizzly-sync?action=expire_stale",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/sms-bus?action=expire_stale",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "api/grizzly-sync.js": {
      "maxDuration": 300
    },
    "api/sms-bus.js": {
      "maxDuration": 300
    },
    "api/owlet.js": {
      "maxDuration": 300
    },
    "api/order.js": {
      "maxDuration": 300
    },
    "api/classy.js": {
      "maxDuration": 300
    },
    "api/order-logsdomain.js": {
      "maxDuration": 300
    },
    "api/sujan.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
