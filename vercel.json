{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/api/pocketfi-checkout",
      "destination": "/api/pocketfi"
    },
    {
      "source": "/api/pocketfi-webhook",
      "destination": "/api/pocketfi"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/dashboard",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/products",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/grizzly-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/logsdomain-numbers?action=sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/products-logsdomain",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/owlet?action=sync",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/grizzly-sync.js": {
      "maxDuration": 300
    },
    "api/logsdomain-numbers.js": {
      "maxDuration": 300
    },
    "api/owlet.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
