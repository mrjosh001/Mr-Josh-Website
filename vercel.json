{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/vendor", "destination": "/vendor.html" },
    { "source": "/vendor/", "destination": "/vendor.html" },
    { "source": "/become-a-vendor", "destination": "/vendor.html" },
    { "source": "/sub-admin", "destination": "/sub-admin.html" },
    { "source": "/sub-admin/", "destination": "/sub-admin.html" },
    { "source": "/api/pocketfi-checkout", "destination": "/api/pocketfi" },
    { "source": "/api/pocketfi-webhook", "destination": "/api/pocketfi" },
    { "source": "/api/products", "destination": "/api/order?action=sync" },
    { "source": "/api/products/", "destination": "/api/order?action=sync" }
  ],
  "redirects": [
    { "source": "/", "destination": "/landing.html", "permanent": false },
    { "source": "/index.html", "destination": "/landing.html", "permanent": false },
    { "source": "/home", "destination": "/landing.html", "permanent": true },
    { "source": "/app", "destination": "/dashboard", "permanent": false }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
